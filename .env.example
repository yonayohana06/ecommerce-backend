# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env; hanya .env.example yang masuk repository.

PORT=3001

# Database PostgreSQL lokal
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=ecommerce_db

# Wajib untuk node-pg-migrate (npm run migrate:*).
# Gunakan ?sslmode=disable untuk PostgreSQL lokal tanpa SSL.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ecommerce_db?sslmode=disable

# Database test terpisah; wajib berbeda dari DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fastshop_test?sslmode=disable

# Batas koneksi pool per proses (default 5, maksimal 20).
DB_POOL_MAX=5

# JWT customer portal
JWT_SECRET=replace_with_random_secret
JWT_EXPIRES_IN=1d

# JWT admin portal; ADMIN_JWT_SECRET wajib berbeda dari JWT_SECRET.
ADMIN_JWT_SECRET=replace_with_different_random_secret
ADMIN_JWT_EXPIRES_IN=8h

# Admin pertama untuk npm run seed:admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_PHONE_NUMBER=

# Payment gateway
PAYMENT_SERVER_KEY=replace_with_payment_server_key

# Supabase Storage untuk bukti transfer
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Rate limit (opsional; nilai berikut adalah default)
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=20
