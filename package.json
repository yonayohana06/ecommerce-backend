{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/app.js",
  "scripts": {
    "test": "node --require ./tests/setup.js --test",
    "test:watch": "node --watch --require ./tests/setup.js --test",
    "test:db:prepare": "node scripts/prepare-test-db.js",
    "test:db": "npm run test:db:prepare && RUN_DB_TESTS=1 node --require ./tests/setup.js --test --test-concurrency=1",
    "test:coverage": "npm run test:db:prepare && RUN_DB_TESTS=1 node --require ./tests/setup.js --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=60 --test-coverage-branches=60 --test-coverage-functions=60",
    "lint": "node scripts/lint.js",
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed:admin": "node scripts/seed-admin.js",
    "create:admin": "node scripts/create-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  }
}
